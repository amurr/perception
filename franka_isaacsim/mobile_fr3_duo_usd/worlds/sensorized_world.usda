        double verticalAperture = 20.25
        float3 xformOp:rotateXYZ = (69.47489, -6.679165e-14, 35.49896)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (7.816923140429507, -10.864370618450776, 5.597380301590099)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
