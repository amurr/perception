                    double3 xformOp:translate = (0.18006265532243781, -0.0978397654227941, 0.03645225015735476)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                }
            }
        }
    }

