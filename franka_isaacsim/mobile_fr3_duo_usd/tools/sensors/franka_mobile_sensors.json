{
  "schema_version": 1,
  "profile_name": "franka_mobile_sensors",
  "model_name": "franka_mobile_sensors",
  "calibration_policy": "synthetic_simulation",
  "notes": "TMR sensor suite: four D455 RGB/depth rigs, front/rear SICK nanoScan3 lidars, and OLV IMU. Calibration values are synthetic simulation profiles.",
  "devices": [
    {
      "logical_name": "camera_front_d455_rgb",
      "device_class": "rgb_depth_camera",
      "hardware_model": "realsense_d455",
      "role": "front_rgb",
      "frame_name_suffix": "camera_front_color_optical_frame",
      "outputs": ["rgb"],
      "native_contract": {
        "backend": "isaac_sim_native",
        "topic_bridge": "none"
      },
      "simulation_calibration": {
        "source": "synthetic_simulation",
        "resolution_hw": [720, 1280],
        "focal_length_px": [650.0, 650.0],
        "principal_point_px": [640.0, 360.0]
      }
    },
