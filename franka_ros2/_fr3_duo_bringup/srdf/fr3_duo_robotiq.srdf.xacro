<?xml version="1.0"?>
<!-- SRDF for fr3_duo_robotiq.urdf.xacro: the duo SRDF of franka_description + Robotiq 2F-85 grippers.

     Added: groups left_gripper / right_gripper (knuckle joint, the others mimic it),
     end effectors, named states left_home / right_home (FR3 "ready", right arm mirrored),
     and disabled collisions between each gripper's links and the arm links it is mounted on. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobile_fr3_duo_v0_2">

  <xacro:include filename="$(find franka_description)/robots/mobile_fr3_duo_v0_2/mobile_fr3_duo_v0_2.srdf.xacro"/>

  <xacro:macro name="robotiq_semantics" params="side">
    <group name="${side}_gripper">
      <joint name="${side}_robotiq_85_left_knuckle_joint"/>
    </group>
    <group_state name="${side}_gripper_open" group="${side}_gripper">
      <joint name="${side}_robotiq_85_left_knuckle_joint" value="0.0"/>
    </group_state>
    <group_state name="${side}_gripper_closed" group="${side}_gripper">
      <joint name="${side}_robotiq_85_left_knuckle_joint" value="0.8"/>
    </group_state>
    <end_effector name="${side}_robotiq" parent_link="${side}_fr3v2_link8" group="${side}_gripper" parent_group="${side}_arm"/>
    <disable_collisions link1="${side}_ur_to_robotiq_link" link2="${side}_robotiq_85_base_link" reason="Gripper"/>
    <disable_collisions link1="${side}_ur_to_robotiq_link" link2="${side}_robotiq_85_left_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_ur_to_robotiq_link" link2="${side}_robotiq_85_right_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_ur_to_robotiq_link" link2="${side}_robotiq_85_left_finger_link" reason="Gripper"/>
    <disable_collisions link1="${side}_ur_to_robotiq_link" link2="${side}_robotiq_85_right_finger_link" reason="Gripper"/>
    <disable_collisions link1="${side}_ur_to_robotiq_link" link2="${side}_robotiq_85_left_inner_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_ur_to_robotiq_link" link2="${side}_robotiq_85_right_inner_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_ur_to_robotiq_link" link2="${side}_robotiq_85_left_finger_tip_link" reason="Gripper"/>
    <disable_collisions link1="${side}_ur_to_robotiq_link" link2="${side}_robotiq_85_right_finger_tip_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_base_link" link2="${side}_robotiq_85_left_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_base_link" link2="${side}_robotiq_85_right_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_base_link" link2="${side}_robotiq_85_left_finger_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_base_link" link2="${side}_robotiq_85_right_finger_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_base_link" link2="${side}_robotiq_85_left_inner_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_base_link" link2="${side}_robotiq_85_right_inner_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_base_link" link2="${side}_robotiq_85_left_finger_tip_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_base_link" link2="${side}_robotiq_85_right_finger_tip_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_left_knuckle_link" link2="${side}_robotiq_85_right_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_left_knuckle_link" link2="${side}_robotiq_85_left_finger_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_left_knuckle_link" link2="${side}_robotiq_85_right_finger_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_left_knuckle_link" link2="${side}_robotiq_85_left_inner_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_left_knuckle_link" link2="${side}_robotiq_85_right_inner_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_left_knuckle_link" link2="${side}_robotiq_85_left_finger_tip_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_left_knuckle_link" link2="${side}_robotiq_85_right_finger_tip_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_right_knuckle_link" link2="${side}_robotiq_85_left_finger_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_right_knuckle_link" link2="${side}_robotiq_85_right_finger_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_right_knuckle_link" link2="${side}_robotiq_85_left_inner_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_right_knuckle_link" link2="${side}_robotiq_85_right_inner_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_right_knuckle_link" link2="${side}_robotiq_85_left_finger_tip_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_right_knuckle_link" link2="${side}_robotiq_85_right_finger_tip_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_left_finger_link" link2="${side}_robotiq_85_right_finger_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_left_finger_link" link2="${side}_robotiq_85_left_inner_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_left_finger_link" link2="${side}_robotiq_85_right_inner_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_left_finger_link" link2="${side}_robotiq_85_left_finger_tip_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_left_finger_link" link2="${side}_robotiq_85_right_finger_tip_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_right_finger_link" link2="${side}_robotiq_85_left_inner_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_right_finger_link" link2="${side}_robotiq_85_right_inner_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_right_finger_link" link2="${side}_robotiq_85_left_finger_tip_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_right_finger_link" link2="${side}_robotiq_85_right_finger_tip_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_left_inner_knuckle_link" link2="${side}_robotiq_85_right_inner_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_left_inner_knuckle_link" link2="${side}_robotiq_85_left_finger_tip_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_left_inner_knuckle_link" link2="${side}_robotiq_85_right_finger_tip_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_right_inner_knuckle_link" link2="${side}_robotiq_85_left_finger_tip_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_right_inner_knuckle_link" link2="${side}_robotiq_85_right_finger_tip_link" reason="Gripper"/>
    <disable_collisions link1="${side}_robotiq_85_left_finger_tip_link" link2="${side}_robotiq_85_right_finger_tip_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link6" link2="${side}_ur_to_robotiq_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link6" link2="${side}_robotiq_85_base_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link6" link2="${side}_robotiq_85_left_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link6" link2="${side}_robotiq_85_right_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link6" link2="${side}_robotiq_85_left_finger_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link6" link2="${side}_robotiq_85_right_finger_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link6" link2="${side}_robotiq_85_left_inner_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link6" link2="${side}_robotiq_85_right_inner_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link6" link2="${side}_robotiq_85_left_finger_tip_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link6" link2="${side}_robotiq_85_right_finger_tip_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link7" link2="${side}_ur_to_robotiq_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link7" link2="${side}_robotiq_85_base_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link7" link2="${side}_robotiq_85_left_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link7" link2="${side}_robotiq_85_right_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link7" link2="${side}_robotiq_85_left_finger_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link7" link2="${side}_robotiq_85_right_finger_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link7" link2="${side}_robotiq_85_left_inner_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link7" link2="${side}_robotiq_85_right_inner_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link7" link2="${side}_robotiq_85_left_finger_tip_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link7" link2="${side}_robotiq_85_right_finger_tip_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link8" link2="${side}_ur_to_robotiq_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link8" link2="${side}_robotiq_85_base_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link8" link2="${side}_robotiq_85_left_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link8" link2="${side}_robotiq_85_right_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link8" link2="${side}_robotiq_85_left_finger_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link8" link2="${side}_robotiq_85_right_finger_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link8" link2="${side}_robotiq_85_left_inner_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link8" link2="${side}_robotiq_85_right_inner_knuckle_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link8" link2="${side}_robotiq_85_left_finger_tip_link" reason="Gripper"/>
    <disable_collisions link1="${side}_fr3v2_link8" link2="${side}_robotiq_85_right_finger_tip_link" reason="Gripper"/>
  </xacro:macro>

  <xacro:robotiq_semantics side="left"/>
  <xacro:robotiq_semantics side="right"/>

  <group_state name="left_home" group="left_arm">
    <joint name="left_fr3v2_joint1" value="0"/>
    <joint name="left_fr3v2_joint2" value="-0.785"/>
    <joint name="left_fr3v2_joint3" value="0"/>
    <joint name="left_fr3v2_joint4" value="-2.356"/>
    <joint name="left_fr3v2_joint5" value="0"/>
    <joint name="left_fr3v2_joint6" value="1.571"/>
    <joint name="left_fr3v2_joint7" value="0.785"/>
  </group_state>
  <group_state name="right_home" group="right_arm">
    <joint name="right_fr3v2_joint1" value="-0"/>
    <joint name="right_fr3v2_joint2" value="-0.785"/>
    <joint name="right_fr3v2_joint3" value="-0"/>
    <joint name="right_fr3v2_joint4" value="-2.356"/>
    <joint name="right_fr3v2_joint5" value="-0"/>
    <joint name="right_fr3v2_joint6" value="1.571"/>
    <joint name="right_fr3v2_joint7" value="-0.785"/>
  </group_state>
</robot>
